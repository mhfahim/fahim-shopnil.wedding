# Where guests' messages are delivered. Both are server-only: never prefix
# them with NEXT_PUBLIC_, or the token ends up in the browser bundle.
#
# Get these by following docs/messages-setup.md, then add them in
# Vercel -> Project -> Settings -> Environment Variables.
#
# Without them the form returns an error instead of pretending to succeed.

MESSAGES_WEBHOOK_URL="https://script.google.com/macros/s/XXXXXXXX/exec"
MESSAGES_WEBHOOK_TOKEN="a-long-random-string-you-invent"
